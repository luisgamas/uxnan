{
  "name": "uxnan-relay",
  "version": "0.0.2-alpha.20260720",
  "private": true,
  "description": "Uxnan Relay — a Cloudflare Worker each user deploys into their own account; pairs a phone with its bridge across networks and forwards opaque E2EE frames.",
  "license": "MPL-2.0",
  "author": "Luis Donaldo Gamas Vazquez",
  "type": "module",
  "exports": {
    "./local": {
      "types": "./dist/src/local/start-local-relay.d.ts",
      "default": "./dist/src/local/start-local-relay.js"
    },
    "./worker-bundle": "./dist/worker/uxnan-relay.js"
  },
  "files": [
    "dist/worker",
    "dist/src/local"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luisgamas/uxnan.git",
    "directory": "relay"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@uxnan/shared": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261002.1",
    "@types/ws": "^8.5.12",
    "esbuild": "0.28.1",
    "miniflare": "4.20260730.0",
    "ws": "^8.18.0"
  }
}
